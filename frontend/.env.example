# Existing backend connection
NEXT_PUBLIC_BACKEND_URL=http://localhost:8081

# Algorand x402 resource server (disabled until the receiver is ready)
X402_ENABLED=false
X402_NETWORK=testnet
X402_AVM_ADDRESS=
X402_FACILITATOR_URL=https://facilitator.goplausible.xyz
X402_QUANTUM_RUN_PRICE=$0.01

# Server-only credential. Must match QB2_X402_GATEWAY_SECRET in FastAPI.
# Generate with: openssl rand -hex 32
X402_GATEWAY_SECRET=

# Server-side bridge; use the same random 32+ character secret in backend and frontend.
AGENT_AUTH_BRIDGE_SECRET=

# Local Better Auth email-OTP sign-in; generate a separate auth secret.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=quantum_platform
RESEND_API_KEY=
OTP_EMAIL_FROM=
